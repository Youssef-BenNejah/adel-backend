# -- App --
APP_PORT=8080
APP_ENV=dev

# -- MongoDB Atlas Cluster --
DB_CLUSTER_URL=<cluster>.mongodb.net
DB_NAME=adel_parfum
DB_USERNAME=<username>
DB_PASSWORD=<password>

# -- JWT - RS256 Keys (base64-encoded) --
# Generate:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
#   base64 -w 0 private.pem   ->  paste as JWT_PRIVATE_KEY
#   base64 -w 0 public.pem    ->  paste as JWT_PUBLIC_KEY
JWT_PRIVATE_KEY=<base64_encoded_RSA_private_key>
JWT_PUBLIC_KEY=<base64_encoded_RSA_public_key>
JWT_ACCESS_TOKEN_EXPIRY_MS=900000
JWT_REFRESH_TOKEN_EXPIRY_MS=604800000

# -- Redis --
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# -- Security --
BCRYPT_STRENGTH=12
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=30

# -- Actuator --
ACTUATOR_USERNAME=admin
ACTUATOR_PASSWORD=securepassword

# -- Shop: admin account (backend-api-spec.md §2.9) --
SHOP_ADMIN_USERNAME=admin
SHOP_ADMIN_EMAIL=admin@adelparfum.tn
SHOP_ADMIN_PASSWORD=adel2026

# -- Shop: media upload validation rules (image-upload-api.md §7) --
SHOP_MEDIA_MAX_BYTES=8388608
SHOP_MEDIA_MIN_DIMENSION=600
SHOP_MEDIA_MAX_DIMENSION=8000
SHOP_MEDIA_PRESIGN_EXPIRY_MINUTES=10
SHOP_MEDIA_ABANDONED_UPLOAD_HOURS=24
SHOP_MEDIA_ORPHAN_GRACE_DAYS=7

# -- Cloudinary: where media bytes actually live (image-upload-api.md §3/§9) --
# https://console.cloudinary.com/ -> Dashboard: cloud name is shown at the top,
# key/secret under Settings -> Access Keys.
CLOUDINARY_CLOUD_NAME=<cloud name>
CLOUDINARY_API_KEY=<api key>
CLOUDINARY_API_SECRET=<api secret>
CLOUDINARY_FOLDER=adel-parfum/media
